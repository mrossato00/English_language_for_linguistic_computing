library(curl)
library(jsonlite)
library(showtext)
library(tidyr)
library(dplyr)
library(readxl)
library(ggplot2)
library(readr)
# Load Google Font
font_add_google("Bai Jamjuree", "bai jamjuree")
showtext_auto()
# Load datasets
df_trump <- read_excel("data_trump.xlsx", sheet = 1)
df_harris <- read_excel("data_harris.xlsx", sheet = 1)
# Add candidate label
df_trump$candidate <- "Trump"
df_harris$candidate <- "Harris"
# Select relevant columns
df_trump_sel <- df_trump %>%
select(word = type, freq, norm_freq = NormFreq, candidate)
df_harris_sel <- df_harris %>%
select(word = type, freq, norm_freq = NormFreq, candidate)
# Define words to keep
common_words <- c("i", "we", "will", "america", "fight", "win", "together")
# Filter
df_trump_filtered <- df_trump_sel %>% filter(word %in% common_words)
df_harris_filtered <- df_harris_sel %>% filter(word %in% common_words)
# Combine
df_combined <- bind_rows(df_trump_filtered, df_harris_filtered)
# Plot
ggplot(df_combined, aes(x = word, y = norm_freq, fill = candidate)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.7), width = 0.6) +
geom_text(aes(label = round(norm_freq, 2)),
position = position_dodge(width = 0.7),
vjust = -0.5, size = 4, family = "bai jamjuree") +
scale_fill_manual(values = c("Trump" = "burlywood1", "Harris" = "chocolate1")) +
labs(
title = "Normalized Frequency of Selected Words by Candidate",
subtitle = "Based on X.com (Twitter) posts — Common lexical items",
x = "Word",
y = "Normalized Frequency",
fill = "Candidate"
) +
theme_light(base_family = "bai jamjuree", base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 18, hjust = 0.5),
plot.subtitle = element_text(size = 14, hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1, size = 12),
axis.text.y = element_text(size = 12),
legend.position = "top",
legend.title = element_text(face = "bold"),
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank()
)
library(curl)
library(curl)
library(jsonlite)
library(showtext)
library(tidyr)
library(dplyr)
library(readxl)
library(ggplot2)
library(readr)
# Load Google Font
font_add_google("Bai Jamjuree", "bai jamjuree")
showtext_auto()
# Load datasets
df_trump <- read_excel("data_trump.xlsx", sheet = 1)
df_harris <- read_excel("data_harris.xlsx", sheet = 1)
# Add candidate label
df_trump$candidate <- "Trump"
df_harris$candidate <- "Harris"
# Select and rename relevant columns
df_trump_sel <- df_trump %>%
select(type, freq, norm_freq = NormFreq, candidate)
df_harris_sel <- df_harris %>%
select(type, freq, norm_freq = NormFreq, candidate)
# Define common words to analyze
common_types <- c("i", "we", "will", "america", "fight", "win", "together")
# Filter data
df_trump_filtered <- df_trump_sel %>% filter(type %in% common_types)
df_harris_filtered <- df_harris_sel %>% filter(type %in% common_types)
# Combine datasets
df_combined <- bind_rows(df_trump_filtered, df_harris_filtered)
# Plot
ggplot(df_combined, aes(x = type, y = norm_freq, fill = candidate)) +
geom_col(position = position_dodge(width = 0.7), width = 0.6) +
geom_text(
aes(label = round(norm_freq, 2)),
position = position_dodge(width = 0.7),
vjust = -0.4, size = 4.2, family = "bai jamjuree", fontface = "bold"
) +
scale_fill_manual(values = c("Trump" = "#E6AC83", "Harris" = "#CC6633")) +
labs(
title = "Normalized Frequency of Selected Words by Candidate",
subtitle = "Analysis of common lexical items in X.com (Twitter) posts",
x = "Type (Word)",
y = "Normalized Frequency",
fill = "Candidate"
) +
scale_y_continuous(expand = expansion(mult = c(0, 0.1))) +
theme_light(base_family = "bai jamjuree", base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 18, hjust = 0.5),
plot.subtitle = element_text(size = 14, hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1, size = 12),
axis.text.y = element_text(size = 12),
legend.position = "top",
legend.title = element_text(face = "bold"),
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank()
)
