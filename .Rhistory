library(curl)
library(jsonlite)
library(showtext)
library(tidyr)
library(dplyr)
library(readxl)
library(ggplot2)
library(readr)
library(scales)
# Font Google
font_add_google("Bai Jamjuree", "bai jamjuree")
showtext_auto()
# Carica i dati
df_trump <- read_excel("data_trump.xlsx", sheet = 1)
df_harris <- read_excel("data_harris.xlsx", sheet = 1)
# Aggiungi colonna candidato
df_trump$candidate <- "Trump"
df_harris$candidate <- "Harris"
# Parole comuni da mantenere
common_words <- c("i", "we", "will", "america", "fight", "win", "together")
# Filtra per parole comuni
df_trump_filtered <- df_trump_sel %>% filter(type %in% common_words)
df_harris_filtered <- df_harris_sel %>% filter(type %in% common_words)
# Combina i dataset
df_combined <- bind_rows(df_trump_filtered, df_harris_filtered)
ggplot(df_combined, aes(x = type, y = norm_freq, fill = candidate)) +
geom_bar(stat = "identity", position = position_dodge(width = 0.7), width = 0.6) +
geom_text(aes(label = round(norm_freq, 2)),
position = position_dodge(width = 0.7),
vjust = -0.4, size = 4, family = "bai jamjuree", color = "black") +
scale_fill_manual(values = c("Trump" = "#D79C70", "Harris" = "#E27D60")) +
scale_y_continuous(
name = "Normalized Frequency",
breaks = seq(0, max(df_combined$norm_freq) + 0.01, by = 0.01),
labels = label_number(accuracy = 0.01),
expand = expansion(mult = c(0, 0.1))
) +
labs(
title = "Normalized Frequency of Selected Lexical Items by Candidate",
subtitle = "Based on X.com posts — Focus on shared vocabulary",
x = "Word Type",
fill = "Candidate"
) +
theme_light(base_family = "bai jamjuree", base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 18, hjust = 0.5),
plot.subtitle = element_text(size = 13, hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1, size = 12),
axis.text.y = element_text(size = 12),
legend.position = "top",
legend.title = element_text(face = "bold"),
panel.grid.major.y = element_line(color = "grey80", size = 0.4),
panel.grid.minor.y = element_line(color = "grey90", size = 0.25),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank()
)
